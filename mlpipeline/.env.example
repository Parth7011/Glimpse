# ============================================
# Glimpse ML Pipeline Environment Configuration
# ============================================

# Database Connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glimpse

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=event-photos

# Local Storage Directory (Fallback for offline development)
LOCAL_STORAGE_DIR=./storage_data

# InsightFace Model Configuration
# Models: buffalo_l (high precision 512-d), buffalo_s (fast 512-d), buffalo_sc (ultra lightweight)
INSIGHTFACE_MODEL=buffalo_l
# -1 for CPU, 0+ for CUDA GPU ID
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_THRESH=0.5
